# Oracle database credentials. Keep real values in .env, never commit them.
ORACLE_USER=your_db_username
ORACLE_PASSWORD=your_db_password
ORACLE_DSN=hostname:port/service_name

# Separate approver identity; required for batch submission.
APPROVER_USERNAME=authorized_approver
APPROVER_PASSWORD=use_a_different_long_unique_password

# Batch submission writes to Oracle; leave disabled until authorization is approved.
ALLOW_BATCH_SUBMISSION=false

# Application settings
APP_USER=maker_user_id
APP_ENV=development
LOG_LEVEL=INFO
