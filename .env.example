# Oracle database credentials. Keep real values in .env, never commit them.
ORACLE_USER=your_db_username
ORACLE_PASSWORD=your_db_password
ORACLE_DSN=hostname:port/service_name

# Batch submission writes to Oracle; leave disabled until approved.
ALLOW_BATCH_SUBMISSION=false

# Application settings
APP_USER=SYSTEM
APP_ENV=development
LOG_LEVEL=INFO
